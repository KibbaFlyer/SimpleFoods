# Copy this file to .env.local and replace the examples with your values.
# Then run: Scripts/configure-local.sh
APPLE_DEVELOPMENT_TEAM=YOUR_TEAM_ID
APP_BUNDLE_IDENTIFIER=com.example.SimpleFoods
WIDGET_BUNDLE_IDENTIFIER=com.example.SimpleFoods.widgets
APP_GROUP_IDENTIFIER=group.com.example.SimpleFoods
APP_PROVISIONING_PROFILE="Your App Provisioning Profile"
WIDGET_PROVISIONING_PROFILE="Your Widget Provisioning Profile"
WIDGET_SIGNING_IDENTITY="iPhone Distribution"
TIP_PRODUCT_ID=com.example.SimpleFoods.tip.small
PUBLIC_REPOSITORY=owner/repository
