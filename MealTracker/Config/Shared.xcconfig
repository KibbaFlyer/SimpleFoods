// Safe public defaults. Config/Local.xcconfig overrides these values locally
// and is generated from .env.local or a protected GitHub Environment.
DEVELOPMENT_TEAM =
SIMPLEFOODS_BASE_BUNDLE_IDENTIFIER = com.example.SimpleFoods
PRODUCT_BUNDLE_IDENTIFIER = $(SIMPLEFOODS_BASE_BUNDLE_IDENTIFIER)
PROVISIONING_PROFILE_SPECIFIER =
SIMPLEFOODS_TIP_PRODUCT_ID =
SIMPLEFOODS_REPOSITORY =
SIMPLEFOODS_WIDGET_SIGNING_STYLE = Automatic
SIMPLEFOODS_WIDGET_PROVISIONING_PROFILE =
SIMPLEFOODS_WIDGET_SIGNING_IDENTITY = Apple Development

SIMPLEFOODS_APP_GROUP = group.$(SIMPLEFOODS_BASE_BUNDLE_IDENTIFIER)
SIMPLEFOODS_WIDGET_BUNDLE_IDENTIFIER = $(SIMPLEFOODS_BASE_BUNDLE_IDENTIFIER).widgets

#include? "Local.xcconfig"
